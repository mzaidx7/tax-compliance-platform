APP_NAME="TBT Compliance Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dubai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tbt_compliance
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
TENANT_FILESYSTEM_DISK=tenant-private
QUEUE_CONNECTION=database
DB_QUEUE=platform
PLATFORM_QUEUE=platform
PLATFORM_HEARTBEAT_FRESH_FOR_SECONDS=300
PLATFORM_SCHEDULED_FIRM_BATCH_SIZE=100
PLATFORM_SCHEDULED_WORK_HEARTBEAT_TTL_SECONDS=86400

FEATURE_CLIENT_MASTER=false
FEATURE_CLIENT_MASTER_FIRM_IDS=
FEATURE_COMPLIANCE_OPERATIONS=false
FEATURE_COMPLIANCE_OPERATIONS_FIRM_IDS=
FEATURE_IMPORTS=false
FEATURE_IMPORTS_FIRM_IDS=
FEATURE_EINVOICING_READINESS=false
FEATURE_EINVOICING_READINESS_FIRM_IDS=
FEATURE_AUDIT_VIEWER=false
FEATURE_AUDIT_VIEWER_FIRM_IDS=
FEATURE_ADMIN_TOOLS=false
FEATURE_ADMIN_TOOLS_FIRM_IDS=

EXPORT_MAX_ROWS=100000
EXPORT_MAX_COLUMNS=100
EXPORT_MAX_CELL_CHARACTERS=32767
EXPORT_MAX_BYTES=52428800
EXPORT_TEMPORARY_MEMORY_BYTES=1048576

CACHE_STORE=database
CACHE_PREFIX=tbt-compliance

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production release requirements:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://compliance.thinkbeyondtax.com
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# MAIL_MAILER must use an operational external transport
# FEATURE_CLIENT_MASTER=true
# FEATURE_COMPLIANCE_OPERATIONS=true
# FEATURE_EINVOICING_READINESS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
